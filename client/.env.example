# Existing Google service account. Share each barber calendar with this account (edit events).
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Default team. Existing GOOGLE_CALENDAR_ID is used for Adam if ADAM_ID is empty.
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_ADAM_ID=
GOOGLE_CALENDAR_JURAJ_ID=
GOOGLE_CALENDAR_STEFAN_ID=
# Optional override of the complete team (each nonempty calendar ID must be unique):
# BARBERS_JSON='[{"id":"adam","name":"Adam","calendarId":"adam@group.calendar.google.com"},{"id":"juraj","name":"Juraj","calendarId":"juraj@group.calendar.google.com"},{"id":"stefan","name":"Štefan","calendarId":"stefan@group.calendar.google.com"}]'

# Staff accounts: generate a password hash with npm run staff:password.
# Add one record per barber using their REAL email and the generated hash.
# No default passwords or public sign-up.
# STAFF_ACCOUNTS_JSON='[{"barberId":"adam","email":"REAL_EMAIL","passwordHash":"GENERATED_HASH"},{"barberId":"juraj","email":"REAL_EMAIL","passwordHash":"GENERATED_HASH"},{"barberId":"stefan","email":"REAL_EMAIL","passwordHash":"GENERATED_HASH"}]'
STAFF_ACCOUNTS_JSON=

# Generate once: openssl rand -hex 32. Keep identical on all app instances.
SESSION_SECRET=
# Exact browser origin, without trailing slash. Set HTTPS origin in production.
APP_ORIGIN=http://localhost:3000
